{
    "name": "x-is-type",
    "version": "1.3.2",
    "description": "A minimal package for simple type-checks of basic types",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "unbuild",
        "prepack": "unbuild",
        "format": "prettier --write .",
        "test": "jest index",
        "test:build": "jest build",
        "test:coverage": "jest --coverage",
        "pre-commit": "lint-staged",
        "pre-push": "npm test",
        "prepublishOnly": "npm run pre-push && npm run build && npm run test:build",
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.{ts,js,mjs,cjs,json}": [
            "eslint",
            "prettier --write"
        ]
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.30.1",
        "@jest/globals": "^29.3.1",
        "@typescript-eslint/eslint-plugin": "latest",
        "@typescript-eslint/parser": "latest",
        "eslint": "^9.30.1",
        "eslint-plugin-prettier": "^5.5.1",
        "globals": "^16.3.0",
        "husky": "^8.0.0",
        "lint-staged": "^16.1.2",
        "prettier": "^3.6.2",
        "ts-jest": "^29.0.3",
        "unbuild": "^3.5.0"
    },
    "author": "Vincent Sjögren",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/vinsjo/x-is-type"
    },
    "keywords": [
        "ESM",
        "CommonJS",
        "typecheck"
    ]
}
